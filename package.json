{
  "name": "pagelens",
  "version": "1.2.1",
  "description": "Chrome extension that estimates the carbon footprint of the current page.",
  "private": true,
  "type": "module",
  "author": "IAMJARL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JarlLyng/PageLens.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:store": "tsc --noEmit && PAGELENS_STORE=1 vite build",
    "package:store": "npm run build:store && cd dist-store && zip -qr ../pagelens-store.zip . && cd .. && echo 'Packaged → pagelens-store.zip'",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@iamjarl/design-tokens": "github:jarllyng/iamjarl-design#v1.32.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tgwf/co2": "^0.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
